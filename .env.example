# =============================================================================
# Plantilla de entorno — copiar a .env.local en desarrollo o configurar en Vercel
# (Settings → Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# Desarrollo local: los mismos valores que docker-compose.yml (usuario, clave y base).
# Producción: DATABASE_URL es la conexión con pooling (Neon pooler o Supabase puerto 6543).
# DIRECT_URL es la conexión directa, solo para `npm run db:deploy` (migraciones).
# En la app serverless no uses la URL directa como DATABASE_URL.
DATABASE_URL=postgresql://ermita:ermita@localhost:5432/ermita?schema=public
DIRECT_URL=postgresql://ermita:ermita@localhost:5432/ermita?schema=public

# Neon (ejemplo):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Supabase (ejemplo): pooler en 6543, sesión directa en 5432.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Obligatorio en producción (Vercel)
# -----------------------------------------------------------------------------
# URL pública del sitio, con https y SIN barra final.
# Ejemplo producción: https://tu-dominio.com o https://proyecto.vercel.app
# En previews de Vercel puedes usar la URL que muestra el despliegue.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave del panel /admin. En producción: contraseña larga y aleatoria.
ADMIN_PASSWORD=admin123

# Token largo para la lista de visitantes del día (ruta /acceso/[token]).
# Si se omite, se deriva de ADMIN_PASSWORD (64 caracteres hex).
# GUARD_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Opcional — notificaciones por correo (SMTP)
# Si no se configura, las solicitudes se guardan en PostgreSQL y no se envía correo.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente visible (si está vacío suele usarse SMTP_USER)
SMTP_FROM=
# Bandeja que recibe avisos de nuevos formularios
NOTIFY_EMAIL=
